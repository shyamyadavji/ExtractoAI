# --- 1. THE MOST IMPORTANT (Security) ---
# This hides your Gemini API keys and Supabase passwords
.env
.streamlit/secrets.toml

# --- 2. PYTHON MESS (Cleanliness) ---
# These are temporary files Python creates that we don't need on GitHub
__pycache__/
*.py[cod]
*$py.class

# --- 3. VIRTUAL ENVIRONMENTS ---
# These are huge folders containing your local libraries
.venv/
venv/
env/

# --- 4. EDITOR SETTINGS ---
# These are just your local VS Code settings
.vscode/
.idea/
.DS_Store